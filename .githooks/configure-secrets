#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if ! command -v git-secrets >/dev/null 2>&1; then
  echo "Push blocked: install git-secrets from https://github.com/awslabs/git-secrets" >&2
  exit 1
fi
aws_pattern='(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}'
if ! git config --get-all secrets.patterns | grep -Fxq -- "$aws_pattern"; then
  git secrets --register-aws >/dev/null
fi
while IFS= read -r pattern; do
  if [ -n "$pattern" ] && ! git config --get-all secrets.patterns | grep -Fxq -- "$pattern"; then
    git secrets --add -- "$pattern"
  fi
done < "$root/.githooks/secrets-patterns"
